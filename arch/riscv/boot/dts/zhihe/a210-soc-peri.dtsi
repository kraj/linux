		usb31_c10phy: phy@8040000 {
			compatible = "zhihe,a210-c10phy";
			reg = <0x00 0x08040000 0x0 0x3C000>,
			      <0x00 0x0807C000 0x0 0x2000>,
			      <0x00 0x0807E000 0x0 0x100>,
			      <0x00 0x08014000 0x0 0x200>;
			reg-names = "phy_ctrl", "tca", "sysreg", "dptx_sys";
			resets = <&rst USB_C10PHY_PHY_RST>;
			reset-names = "phy-rst";
			#phy-cells = <0>;
			power-domains = <&power_usb>;
		};

		usb20phy0: phy@08300000 {
			compatible = "zhihe,a210-usb2-phy0";
			reg = <0x00 0x8300000 0x0 0x1000>;
			reg-names = "usb20-blk-sysreg";
			resets = <&rst USB_USB20_BLK_USB0_PHY_PON_RESET>;
			reset-names = "phy-rst";
			#phy-cells = <0>;
			power-domains = <&power_usb>;
			zhihe,init-seq = /bits/ 32 <0x000 0x40b67b5b>;
		};

		usb20phy1: phy@08301000 {
			compatible = "zhihe,a210-usb2-phy1";
			reg = <0x00 0x8301000 0x0 0x1000>;
			reg-names = "usb20-blk-sysreg";
			resets = <&rst USB_USB20_BLK_USB1_PHY_PON_RESET>;
			reset-names = "phy-rst";
			#phy-cells = <0>;
			power-domains = <&power_usb>;
			zhihe,init-seq = /bits/ 32 <0x000 0x40b67b5b>;
		};

		usb31_syscon: syscon@8000000 {
			compatible = "syscon";
			reg = <0x00 0x08000000 0x0 0x1000>;
		};

		usb20phy2: usb2-phy {
			compatible = "zhihe,a210-usb2-phy2";
			syscon = <&usb31_syscon>;
			resets = <&rst USB_USB31_PHY_RST>;
			reset-names = "phy-rst";
			#phy-cells = <0>;
			zhihe,init-seq = /bits/ 32 <0x0a0 0x1000>;
		};
		usb31: usb3@8001000 {
			compatible = "zhihe,usb31";
			syscon = <&usb31_syscon>;
			clocks = <&clk_usb USB31_REF_CLK_EN>,
				<&clk_usb USB31_SLV_AFENCE_ACLK_EN>,
				<&clk_usb USB_SS_PERI2_CFG_ACLK_EN>;
			clock-names = "ref-clk", "slv-aclk", "cfg-aclk";
			resets = <&rst USB_USB31_SLV_AFENCE_ARST>;
			reset-names = "usb31-arst";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			usb3: dwc3@8100000 {
				compatible = "snps,dwc3";
				reg = <0x00 0x8100000 0x0 0x100000>;
				interrupt-parent = <&intc>;
				interrupts = <183>;
				clocks = <&clk_usb USB31_PCLK_EN>,
					<&clk_usb USB31_BUS_CLK_EN>,
					<&clk_usb USB31_SUSPEND_CLK_EN>;
				clock-names = "pclk", "bus_clk", "suspend_clk";
				reg-shift = <2>;
				reg-io-width = <4>;
				dr_mode = "host";
				power-domains = <&power_usb>;
				phys = <&usb20phy2>, <&usb31_c10phy>;
				phy-names = "usb2-phy", "usb3-phy";
				//iommus = <&iommu DEVID_DIE0_USB3_0>;
				snps,usb3_lpm_capable;
				snps,usb_sofitpsync;
			};
		};

		usb2_0: usb2@8200000 {
			compatible = "zhihe,a210-usb", "snps,dwc2";
			reg = <0x00 0x8200000 0x0 0x40000>;
			interrupt-parent = <&intc>;
			interrupts = <181>;
			clocks = <&clk_usb USB20_BUS_CLK>;
			clock-names = "otg";
			resets = <&rst USB_USB20_BLK_USB2_WRAP0_HRST>;
			reset-names = "dwc2";
			phys = <&usb20phy0>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			maximum-speed = "high-speed";
			reg-shift = <2>;
			reg-io-width = <4>;
			g-np-tx-fifo-size = <16>;
			g-rx-fifo-size = <275>;
			g-tx-fifo-size = <256 128 128 64 64 32>;
			power-domains = <&power_usb>;
			// iommus = <&iommu DEVID_DIE0_USB2_0>;
			snps,need-phy-for-wake;
		};

		usb2_1: usb2@8240000 {
			compatible = "zhihe,a210-usb", "snps,dwc2";
			reg = <0x00 0x8240000 0x0 0x40000>;
			interrupt-parent = <&intc>;
			interrupts = <182>;
			clocks = <&clk_usb USB20_BUS_CLK>;
			clock-names = "otg";
			resets = <&rst USB_USB20_BLK_USB2_WRAP1_HRST>;
			reset-names = "dwc2";
			phys = <&usb20phy1>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			maximum-speed = "high-speed";
			reg-shift = <2>;
			reg-io-width = <4>;
			g-np-tx-fifo-size = <16>;
			g-rx-fifo-size = <275>;
			g-tx-fifo-size = <256 128 128 64 64 32>;
			power-domains = <&power_usb>;
			// iommus = <&iommu DEVID_DIE0_USB2_1>;
			snps,need-phy-for-wake;
		};

