			compatible = "zhihe,i2s3-8ch-sd0";
			reg = <0x0 0x0840c000 0x0 0x1000>,
			      <0x0 0x00240000 0x0 0x4>;
			interrupt-parent = <&intc>;
			interrupts = <304>;
			clocks = <&clk_peri PERI2_I2S3_SRC_CLK_EN>, <&clk_peri PERI2_I2S3_PCLK_EN>;
