		e16phy: e16phy@a1800000 {
			compatible = "zhihe,a210-e16phy";
			reg = <0x00 0xa180000 0x0 0x001000>;
			#phy-cells = <0>;
			clocks = <&clk_pcie E16PHY_PCLK_EN>;
			clock-names = "e16phy_clk";
			resets = <&rst PCIE_E16PHY_APBS_PRST>,<&rst PCIE_E16PHY_PHY_RST>;
			reset-names = "apb", "phy";
			/* PCIE_DMx4 */
			init-seq-pcie_dmx4 = /bits/ 32 <0x000 0x00110000>,
							<0x004 0x00000000>,
							<0x008 0x00000000>,
							<0x108 0x00000011>,
							<0x048 0x00010001>;
			/* PCIE_DMx2,PCIE_RPx1 */
			init-seq-pcie_dmx2_rpx1 = /bits/ 32 <0x000 0x00110100>,
							<0x004 0x00000000>,
							<0x008 0x00000000>,
							<0x108 0x00000011>,
							<0x048 0x00010001>;
			/* PCIE_DMx2,SATA_x2 */
			init-seq-pcie_dmx2_satax2 = /bits/ 32 <0x000 0x00110001>,
							<0x004 0x00001100>,
							<0x008 0x00002200>,
							<0x108 0x00000011>,
							<0x048 0x00010001>;
			/* PCIE_DMx1,PCIE_RPx1,SATA_x2 */
			init-seq-pcie_dmx1_rpx1_satax2 = /bits/ 32 <0x000 0x00110101>,
							<0x004 0x00001100>,
							<0x008 0x00002200>,
							<0x108 0x00000011>,
							<0x048 0x00010001>;
			init-seq-select = "pcie_dmx4";
		};

		dm3x4: pcie@b000000 {
			compatible = "zhihe,a210-pcie";
			reg = <0x00 0x0b000000 0x0 0x800000>,
				<0x18 0x00000000 0x0 0x200000>,
				<0x00 0x0A004000 0x0 0x001000>;
			reg-names = "dbi","config","pcie_sysreg";
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			device_type = "pci";
			bus-range = <0x00 0xff>;
